# DataGridle Environment Variables

# Backend
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://datagridle:datagridle@postgres:5432/datagridle
DATABASE_URL_SYNC=postgresql://datagridle:datagridle@postgres:5432/datagridle

# PostgreSQL
POSTGRES_USER=datagridle
POSTGRES_PASSWORD=datagridle
POSTGRES_DB=datagridle

# Redis
REDIS_URL=redis://redis:6379/0

# OAuth (optional for MVP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Object Storage (optional for MVP)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=datagridle

# Groq (optional – for personalized LLM suggestions)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=DataGridle
